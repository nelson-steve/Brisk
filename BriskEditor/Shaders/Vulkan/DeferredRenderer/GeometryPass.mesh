#version 460
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_8bit_storage  : require
#extension GL_EXT_mesh_shader          : require
#extension GL_GOOGLE_include_directive: require

#include "Mesh.hpp"
#include "../config.hpp"

layout(local_size_x = MESH_WGSIZE, local_size_y = 1, local_size_z = 1) in;
layout(triangles, max_vertices = MESH_MAXVTX, max_primitives = MESH_MAXTRI) out;

layout(std140, set = 0, binding = 0) uniform MVPBuffer {
    mat4 ProjView;
    mat4 View;
    vec3 CamPos;
} MVP;

layout(push_constant) uniform MeshDataBuffer {
    mat4 model;
    int  materialIndex;
} ObjectData;

layout(std430, set = 0, binding = 3) readonly buffer VerticesBuffer {
    Vertex vertices[];
} Vertices;

layout(std430, set = 0, binding = 4) readonly buffer MeshletsBuffer {
    Meshlet meshlets[];
} Meshlets;

layout(set = 0, binding = 8) readonly buffer MeshletDataBuffer {
	uint meshletData[];
} MeshletData;

layout(set = 0, binding = 8) readonly buffer MeshletDataBuffer16 {
	uint16_t meshletData16[];
} MeshletData16;

layout(set = 0, binding = 8) readonly buffer MeshletDataBuffer8 {
	uint8_t meshletData8[];
} MeshletData8;

layout(set = 0, binding = 9) readonly buffer MeshDrawsBuffer {
	MeshDraw meshDraws[];
} MeshDraws;

layout(location = 0) out vec3 fragPosition[];
layout(location = 1) out vec3 fragNormal[];
layout(location = 2) out vec2 fragUV[];
layout(location = 3) flat out uint outMaterialIndex[];

void main()
{
	uint ti = gl_LocalInvocationIndex;

    uint mi     = gl_WorkGroupID.x;
    uint vertexCount = uint(Meshlets.meshlets[mi].vertexCount);
    uint triangleCount = uint(Meshlets.meshlets[mi].triangleCount);

    SetMeshOutputsEXT(vertexCount, triangleCount);

	uint dataOffset = Meshlets.meshlets[mi].dataOffset;
	uint baseVertex = Meshlets.meshlets[mi].baseVertex;
	bool shortRefs = uint(Meshlets.meshlets[mi].shortRefs) == 1;
	uint vertexOffset = dataOffset;
	uint indexOffset = dataOffset + (shortRefs ? (vertexCount + 1) / 2 : vertexCount);    

    for (uint i = ti; i < vertexCount; i += MESH_WGSIZE)
    {
		uint vi = shortRefs ? uint(MeshletData16.meshletData16[vertexOffset * 2 + i]) + baseVertex : MeshletData.meshletData[vertexOffset + i] + baseVertex;

        vec3 pos    = vec3(Vertices.vertices[vi].vx, Vertices.vertices[vi].vy, Vertices.vertices[vi].vz);
        vec3 normal = vec3(Vertices.vertices[vi].nx, Vertices.vertices[vi].ny, Vertices.vertices[vi].nz);

        vec4 worldPos = ObjectData.model * vec4(pos, 1.0);
        //vec3 worldNormal = normalize(mat3(transpose(inverse(ObjectData.model))) * normal);        
        vec3 worldNormal = normal;        
        vec2 uv = vec2(Vertices.vertices[vi].tx, Vertices.vertices[vi].ty);        
        gl_MeshVerticesEXT[i].gl_Position = MVP.ProjView * worldPos;

        fragPosition[i] = worldPos.xyz;
        fragNormal[i]   = worldNormal;
        fragUV[i]       = uv;        
    }

    barrier();

	for (uint i = ti; i < triangleCount; i += MESH_WGSIZE)
    {
		uint offset = indexOffset * 4 + i * 3;
		uint a = uint(MeshletData8.meshletData8[offset]), b = uint(MeshletData8.meshletData8[offset + 1]), c = uint(MeshletData8.meshletData8[offset + 2]);

		gl_PrimitiveTriangleIndicesEXT[i] = uvec3(a, b, c);

        //outMaterialIndex[i] = uint(Meshlets.meshlets[mi].materialIndex);                
    }
}