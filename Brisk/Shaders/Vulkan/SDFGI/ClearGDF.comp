#version 460
layout(local_size_x = 8, local_size_y = 8, local_size_z = 8) in;

layout(push_constant) uniform Push {
	ivec3 Dimenstion;
	float ClearValue;
} pc;

layout(r16f, set = 0, binding = 0) uniform image3D GDF;

void main() {
	ivec3 grid = ivec3(gl_GlobalInvocationID.xyz);
	if(any(greaterThanEqual(grid, pc.Dimenstion))) return ;
	imageStore(GDF, grid, vec4(pc.ClearValue));
}

