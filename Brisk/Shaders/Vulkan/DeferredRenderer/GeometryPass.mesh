#version 460
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_8bit_storage  : require
#extension GL_EXT_mesh_shader          : require

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
layout(triangles, max_vertices = 64, max_primitives = 42) out;

struct MeshData {
    vec3 Position;
    float _pad0;

    vec3 Normal;
    float _pad1;

    vec2 UV0;
    vec2 UV1;

    vec3 Color;
    float _pad2;

    vec4 Tangent;
    uvec4 JointIndices;
    vec4 JointWeights;
};

layout(std140, set = 0, binding = 0) uniform MVPBuffer {
    mat4 ProjView;
    mat4 View;
    vec3 CamPos;
} MVP;

//layout(push_constant) uniform MeshDataBuffer {
//    mat4 model;
//    int  materialIndex;
//} ObjectData;

layout(std430, set = 0, binding = 3) readonly buffer VerticesBuffer {
    MeshData vertices[];
} Vertices;

struct Meshlet {
    uint    vertices[64];   // local-to-meshlet vertex table
    uint8_t indices[126];   // flat index buffer (total indices, not triangles)
    uint8_t indexCount;     // total indices used (<= 126)
    uint8_t vertexCount;    // total vertices used (<= 64)
};

layout(std430, set = 0, binding = 4) readonly buffer MeshletsBuffer {
    Meshlet meshlets[];
} Meshlets;

layout(location = 0) out vec3 fragPosition[];
layout(location = 1) out vec3 fragNormal[];
layout(location = 2) out vec2 fragUV[];

void main()
{
    uint mi     = gl_WorkGroupID.x;
    uint vCount = uint(Meshlets.meshlets[mi].vertexCount);
    uint iCount = uint(Meshlets.meshlets[mi].indexCount);
    uint pCount = iCount / 3u;

    SetMeshOutputsEXT(vCount, pCount);

    for (uint i = 0u; i < vCount; ++i)
    {
        uint vi = Meshlets.meshlets[mi].vertices[i];

        vec3 pos    = Vertices.vertices[vi].Position;
        vec3 normal = Vertices.vertices[vi].Normal;

        vec4 worldPos = mat4(1.0) * vec4(pos, 1.0);
        //vec3 worldNormal = normalize(mat3(transpose(inverse(ObjectData.model))) * normal);        
        vec3 worldNormal = normal;        
        vec2 uv0 = Vertices.vertices[vi].UV0;        
        gl_MeshVerticesEXT[i].gl_Position = MVP.ProjView * worldPos;

        fragPosition[i] = worldPos.xyz;
        fragNormal[i]   = worldNormal;
        fragUV[i]       = uv0;        
    }

    // Write triangle indices (advance by 3)
    for (uint t = 0u; t < pCount; ++t)
    {
        uint i0 = uint(Meshlets.meshlets[mi].indices[t*3u + 0u]);
        uint i1 = uint(Meshlets.meshlets[mi].indices[t*3u + 1u]);
        uint i2 = uint(Meshlets.meshlets[mi].indices[t*3u + 2u]);

        gl_PrimitiveTriangleIndicesEXT[t] = uvec3(i0, i1, i2);
    }
}